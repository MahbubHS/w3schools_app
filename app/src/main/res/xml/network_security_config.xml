<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- HTTPS only, system + user-added trust anchors. W3Schools serves over
         HTTPS, so no cleartext exceptions are defined here. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
